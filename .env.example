APP_NAME=筑脉企服 Backend
APP_ENV=development
DEBUG=true

API_PREFIX=/api

DATABASE_URL=sqlite:///./data/zumaix_enterprise_service.db

LOG_LEVEL=INFO

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1):\d+

CONTENT_FETCH_TIMEOUT_SECONDS=10
CONTENT_MAX_BYTES=5242880
CONTENT_MAX_REDIRECTS=5
CONTENT_USER_AGENT=ZumaixEnterpriseService/0.1
CONTENT_MIN_TEXT_LENGTH=20
CONTENT_EXCERPT_LENGTH=400

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_INPUT_CHARS=24000

DEV_IDENTITY_ENABLED=true

FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_BITABLE_APP_TOKEN=
FEISHU_SERVICE_CASE_TABLE_ID=
FEISHU_REQUEST_TIMEOUT_SECONDS=10

